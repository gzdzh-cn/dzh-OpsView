[Unit]
Description=OpsView panel
After=network.target opsview-executor.service
Wants=opsview-executor.service
[Service]
Type=simple
User=opsview
Group=opsview
WorkingDirectory=/var/lib/opsview/panel
ExecStart=/opt/opsview/bin/opsview serve --config /etc/opsview/panel.json --data /var/lib/opsview/panel --socket /run/opsview/executor.sock
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opsview/panel
[Install]
WantedBy=multi-user.target
